{
  "provider": "deepseek",
  "api_base": "https://api.deepseek.com",
  "api_key_env": "DEEPSEEK_API_KEY",
  "text_model": "deepseek-flash",
  "generation_mode": "legacy",
  "achievement_report_mode": "expression",
  "compact_writer_model": "deepseek-flash",
  "compact_audit_model": "deepseek-flash",
  "compact_adjudicator_model": "deepseek-flash",
  "compact_repair_model": "deepseek-flash",
  "generation_budget_seconds": 75,
  "stream": true,
  "request_timeout_seconds": 75,
  "request_idle_timeout_seconds": 30,
  "request_total_budget_seconds": 75,
  "request_attempts": 1,
  "max_llm_concurrency": 4,
  "alignment_workers": 3,
  "report_workers": 2,
  "evidence_workers": 2,
  "audit_workers": 3,
  "review_workflow": "grouped"
}
